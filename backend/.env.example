# ==============================================================================
# HOTEL CORTEZ HALLOWEEN 2026 - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Porta da aplicação (desenvolvimento local)
PORT=3001
NODE_ENV=development

# URL Oficial do Frontend (para validação restrita de CORS e URLs de retorno)
# Desenvolvimento: http://localhost:3000
# Preview / Vercel: https://hotel-cortez-preview.vercel.app
# Produção: https://hotelcortez.com.br
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# BANCO DE DADOS POSTGRESQL (Vercel Postgres, Supabase ou Neon)
# ------------------------------------------------------------------------------
# String de conexão com pooling seguro para ambientes serverless
DATABASE_URL="postgresql://usuario:senha@ep-xyz-pooler.us-east-2.aws.neon.tech/hotel_cortez?sslmode=require"

# ------------------------------------------------------------------------------
# MERCADO PAGO CREDENCIAIS
# ------------------------------------------------------------------------------
# AVISO: Nunca comite chaves reais! Em desenvolvimento/preview utilize credenciais
# de teste (Sandbox). Em produção na Vercel, utilize as chaves de Produção.
#
# Onde encontrar no Mercado Pago:
# Acesse https://www.mercadopago.com.br/developers/panel -> Suas Aplicações -> Credenciais
MP_ACCESS_TOKEN="TEST_ACCESS_TOKEN_PLACEHOLDER"
MP_PUBLIC_KEY="TEST_PUBLIC_KEY_PLACEHOLDER"

# Webhook Secret gerado pelo Mercado Pago para validação HMAC-SHA256
# Onde encontrar: Developers Panel -> Notificações Webhooks -> Chave secreta de assinatura
MP_WEBHOOK_SECRET="TEST_WEBHOOK_SECRET_PLACEHOLDER"

# URL pública do webhook (ex: https://seu-dominio.vercel.app/api/payments/webhook ou ngrok em dev)
MP_BACKEND_WEBHOOK_URL="http://localhost:3001/api/payments/webhook"

# ------------------------------------------------------------------------------
# AUTENTICAÇÃO DO PAINEL ADMINISTRATIVO (JWT)
# ------------------------------------------------------------------------------
# Chave secreta forte para assinar os tokens JWT do admin
JWT_SECRET="CORTEZ_SUPER_SECRET_JWT_KEY_DEV_ONLY_2026"
JWT_EXPIRES_IN="8h"

# Credenciais do Administrador Padrão (utilizado no seed inicial)
INITIAL_ADMIN_EMAIL="admin@hotelcortez.com"
INITIAL_ADMIN_PASSWORD="Cortez@2026!Admin"

# ------------------------------------------------------------------------------
# DISPARO DE E-MAILS TRANSACIONAIS (RESEND / SENDGRID)
# ------------------------------------------------------------------------------
# Disparado de forma assíncrona APENAS após a confirmação real do pagamento
RESEND_API_KEY="TEST_RESEND_API_KEY_PLACEHOLDER"
EMAIL_FROM="Hotel Cortez <ingressos@hotelcortez.com>"
