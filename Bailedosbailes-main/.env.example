# Supabase Database & Auth Configuration
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
SUPABASE_SECRET_KEY="your_sb_secret_key"

# PostgreSQL usado pelo Nest/Prisma para o CRUD administrativo
DATABASE_URL="postgresql://usuario:senha@host:5432/hotel_cortez?sslmode=require"

# Admin Authentication Key (OBRIGATÓRIO - define a senha de login do painel administrativo)
ADMIN_USER="admin@example.com"
ADMIN_KEY="your_secure_admin_password"
ADMIN_SESSION_SECRET="generate_a_different_long_random_secret"
